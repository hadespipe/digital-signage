{
  "name": "lg-digital-signage",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:player": "bun test tests/player",
    "test:server": "bun test tests/server",
    "test:e2e": "playwright test",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "check:tv": "node scripts/check-tv.mjs",
    "package:tv": "bun run check:tv && bun scripts/package-tv.ts"
  },
  "dependencies": {
    "hono": "4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@webos-tools/cli": "3.2.6",
    "acorn": "8.19.0",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  }
}
