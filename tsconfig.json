{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "playwright.config.ts"
  ]
}
